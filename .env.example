# Copy to .env.local and fill in. Never commit .env.local.
DATABASE_URL=file:./data/cafe.db
# Long random string used to sign session cookies (required in production)
SESSION_SECRET=Ujinka61221166
# Admin account created/updated by `npm run db:seed`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=61221166
ADMIN_NAME=Café Admin

# Wire.mn QPay (server-only secrets; never use NEXT_PUBLIC_)
WIRE_API_KEY=
WIRE_QPAY_OPERATOR_ID=qpay
# Required HTTPS origin in production; local development infers localhost
APP_URL=
# Optional: signing secret for POST /api/payments/wire/webhook
WIRE_WEBHOOK_SECRET=
