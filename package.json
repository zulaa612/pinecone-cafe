  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:push": "node --env-file-if-exists=.env.local --import tsx scripts/push-database.mts",
    "db:check": "node --env-file-if-exists=.env.local --import tsx scripts/check-database.mts",
    "db:import:sqlite": "node --env-file-if-exists=.env.local --import tsx scripts/import-sqlite.mts",
